<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/nebr_white">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:contentInsetStartWithNavigation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Routes"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/nebr_yellow"
                android:fontFamily="@font/dela_gothic_one"
                app:fontFamily="@font/dela_gothic_one"/>

        </LinearLayout>

    </com.google.android.material.appbar.MaterialToolbar>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/nebr_white"
        app:tabIndicatorColor="@color/nebr_yellow"
        app:tabIndicatorHeight="3dp"
        app:tabSelectedTextColor="@color/nebr_black"
        app:tabTextColor="@color/nebr_gray"
        app:tabMode="fixed"
        app:tabGravity="fill"
        android:elevation="0dp"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/nebr_divider"/>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fabAddRoute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="24dp"
            android:text="Add Route"
            android:textStyle="bold"
            android:textColor="@color/nebr_white"
            app:icon="@android:drawable/ic_input_add"
            app:iconTint="@color/nebr_white"
            app:backgroundTint="@color/nebr_black"/>

    </FrameLayout>

</LinearLayout>