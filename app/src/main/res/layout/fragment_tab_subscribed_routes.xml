<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nebr_white">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSubscribedRoutesTab"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="88dp"
        android:visibility="visible"/>

    <LinearLayout
        android:id="@+id/layoutEmptyStateSub"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚗"
            android:textSize="64sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="No Subscribed Route Yet"
            android:textSize="18sp"
            android:textColor="@color/nebr_black"
            android:textStyle="bold"
            android:fontFamily="@font/dela_gothic_one"
            app:fontFamily="@font/dela_gothic_one"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Discover ride-sharing routes that match your direction in the Explore menu."
            android:textSize="14sp"
            android:textColor="@color/nebr_gray"
            android:gravity="center"
            android:fontFamily="@font/plus_jakarta_sans"/>

    </LinearLayout>

</FrameLayout>
