<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/exploreFragment">

    <fragment
        android:id="@+id/exploreFragment"
        android:name="com.marsya.nebr.fragment.ExploreFragment"
        android:label="Explore"/>

    <fragment
        android:id="@+id/myRoutesFragment"
        android:name="com.marsya.nebr.fragment.MyRoutesFragment"
        android:label="My Routes">
        <action
            android:id="@+id/action_myRoutesFragment_to_createRouteFragment"
            app:destination="@id/createRouteFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.marsya.nebr.fragment.ProfileFragment"
        android:label="Profile"/>

    <fragment
        android:id="@+id/createRouteFragment"
        android:name="com.marsya.nebr.fragment.CreateRouteFragment"
        android:label="Create New Route"/>

</navigation>